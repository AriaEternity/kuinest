NODE_ENV=production
APP_MODE=private
DATA_ROOT=/var/lib/kuinest/data
BIND_HOST=127.0.0.1
PORT=4317
PUBLIC_ORIGIN=https://chat.example.com
TRUST_PROXY=loopback
CURSOR_HMAC_KEY_FILE=/var/lib/kuinest/data/cursor.key
RUNTIME_BINDING_SHA256=REPLACE_WITH_INITIALIZATION_OUTPUT
PROVIDER_API_KEY_FILE=/etc/kuinest/credentials/provider.key
ALLOWED_PROVIDER_ORIGIN=https://api.deepseek.com
ALLOW_LIVE_MODEL=false
ENABLE_SCHEDULER=false
ENABLE_BACKUPS=true
ENABLE_BACKUP_RETENTION=false
